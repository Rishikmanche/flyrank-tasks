{
  "openapi": "3.0.0",
  "info": {
    "title": "FlyRank Enterprise Task, Auth, AI, Background Jobs & PDF API",
    "version": "7.0.0",
    "description": "Production Express REST API featuring Supabase Auth JWT protection, PostgreSQL persistence, AI LLM Structured Judgment, Asynchronous Background Job Queue with Idempotency (BE-06), and Background PDF Generation Pipeline (BE-08)."
  },
  "paths": {
    "/jobs": {
      "post": {
        "summary": "Enqueue a slow task into background worker queue (Accept Fast 202)",
        "tags": ["Background Jobs API"],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Unique client idempotency token to prevent duplicate task execution",
            "schema": { "type": "string", "example": "req_unique_9a8b7c" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "example": "Urgent: Fix PostgreSQL connection leak in production pool" }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted and enqueued in background",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "jobId": { "type": "string", "example": "job_1787679511174_04745d9b" },
                    "status": { "type": "string", "example": "queued" },
                    "isDuplicate": { "type": "boolean", "example": false },
                    "statusUrl": { "type": "string", "example": "/jobs/job_1787679511174_04745d9b" },
                    "createdAt": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input payload"
          }
        }
      },
      "get": {
        "summary": "List all background jobs in queue",
        "tags": ["Background Jobs API"],
        "responses": {
          "200": {
            "description": "List of background jobs"
          }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "summary": "Poll status and results of a background job",
        "tags": ["Background Jobs API"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Job execution status and payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": { "type": "string" },
                    "status": { "type": "string", "enum": ["queued", "processing", "completed", "failed"] },
                    "attempts": { "type": "integer" },
                    "result": { "type": "object" },
                    "error": { "type": "string", "nullable": true },
                    "createdAt": { "type": "string" },
                    "completedAt": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    },
    "/reports/generate": {
      "post": {
        "summary": "Enqueue background PDF report generation job",
        "tags": ["PDF Reports API"],
        "responses": {
          "202": {
            "description": "Report job queued successfully"
          }
        }
      }
    },
    "/reports/jobs/{id}": {
      "get": {
        "summary": "Poll status of a background report generation job",
        "tags": ["PDF Reports API"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status details"
          },
          "404": {
            "description": "Report job not found"
          }
        }
      }
    },
    "/reports/download/{id}": {
      "get": {
        "summary": "Download generated PDF artifact file",
        "tags": ["PDF Reports API"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Binary PDF stream"
          }
        }
      }
    },
    "/ai/classify-task": {
      "post": {
        "summary": "Classify unstructured text into trusted JSON task judgment",
        "tags": ["AI Judgment API"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured JSON judgment"
          }
        }
      }
    }
  }
}
