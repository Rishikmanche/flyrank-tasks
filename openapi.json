{
  "openapi": "3.0.0",
  "info": {
    "title": "FlyRank Task, Auth, AI & PDF Report API",
    "version": "6.0.0",
    "description": "Enterprise Express REST API with Supabase Auth, Bearer JWT middleware, PostgreSQL persistence, AI LLM Structured Judgment, and Asynchronous PDF Report Background Pipeline."
  },
  "paths": {
    "/reports/generate": {
      "post": {
        "summary": "Enqueue background PDF report generation job",
        "tags": ["PDF Reports API"],
        "responses": {
          "202": {
            "description": "Report job queued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "jobId": { "type": "string", "example": "rep_1787679221765_sp2rg" },
                    "status": { "type": "string", "example": "queued" },
                    "createdAt": { "type": "string" },
                    "statusUrl": { "type": "string", "example": "/reports/jobs/rep_1787679221765_sp2rg" },
                    "downloadUrl": { "type": "string", "example": "/reports/download/rep_1787679221765_sp2rg" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reports/jobs/{id}": {
      "get": {
        "summary": "Poll status of a background report generation job",
        "tags": ["PDF Reports API"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": { "type": "string" },
                    "status": { "type": "string", "enum": ["queued", "processing", "completed", "failed"] },
                    "createdAt": { "type": "string" },
                    "completedAt": { "type": "string" },
                    "fileSize": { "type": "string", "example": "4.3 KB" },
                    "downloadUrl": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Report job not found"
          }
        }
      }
    },
    "/reports/download/{id}": {
      "get": {
        "summary": "Download generated PDF artifact file",
        "tags": ["PDF Reports API"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Binary PDF stream",
            "content": {
              "application/pdf": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "400": {
            "description": "Report not ready yet"
          },
          "404": {
            "description": "Report job or file not found"
          }
        }
      }
    },
    "/reports/history": {
      "get": {
        "summary": "List all historical report generation jobs",
        "tags": ["PDF Reports API"],
        "responses": {
          "200": {
            "description": "List of report jobs"
          }
        }
      }
    },
    "/reports/schedule": {
      "post": {
        "summary": "Configure automated periodic report generation schedule",
        "tags": ["PDF Reports API"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "intervalSeconds": { "type": "integer", "example": 3600 },
                  "enabled": { "type": "boolean", "example": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Schedule updated"
          }
        }
      }
    },
    "/ai/classify-task": {
      "post": {
        "summary": "Classify unstructured text into trusted JSON task judgment",
        "tags": ["AI Judgment API"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": {
                    "type": "string",
                    "example": "Urgent: Fix production PostgreSQL connection leak before tomorrow morning"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured JSON judgment matching Zod schema"
          }
        }
      }
    }
  }
}
